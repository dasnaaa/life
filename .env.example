# In .env kopieren und mit den Werten aus dem eigenen Supabase-Projekt fuellen.
# Diese Werte landen im Client-Bundle (EXPO_PUBLIC_-Praefix) - das ist bei
# Supabase so vorgesehen, der anon key ist per RLS abgesichert.
#
# Settings -> API im Supabase Dashboard
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web-Push (Paket 11): der VAPID Public Key ist NICHT geheim (das ist bei
# VAPID so vorgesehen) und muss daher hier zusaetzlich zu den Supabase
# Secrets gesetzt werden, damit der Browser ihn beim Abonnieren nutzen kann.
# Muss exakt dem VAPID_PUBLIC_KEY aus den Supabase Secrets entsprechen.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# NIEMALS hier eintragen: GEMINI_API_KEY, Google/Slack/ClickUp Client Secrets,
# VAPID_PRIVATE_KEY. Diese gehoeren ausschliesslich in die Supabase Edge
# Function Secrets:
#   supabase secrets set GEMINI_API_KEY=... VAPID_PRIVATE_KEY=... VAPID_PUBLIC_KEY=... VAPID_SUBJECT=mailto:du@example.com
