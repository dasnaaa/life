# In .env kopieren und mit den Werten aus dem eigenen Supabase-Projekt fuellen.
# Diese Werte landen im Client-Bundle (EXPO_PUBLIC_-Praefix) - das ist bei
# Supabase so vorgesehen, der anon key ist per RLS abgesichert.
#
# Settings -> API im Supabase Dashboard
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NIEMALS hier eintragen: GEMINI_API_KEY, Google/Slack/ClickUp Client Secrets.
# Diese gehoeren ausschliesslich in die Supabase Edge Function Secrets:
#   supabase secrets set GEMINI_API_KEY=...
