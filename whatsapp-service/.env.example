# Port, auf dem die REST-API laeuft
PORT=3001

# Frei waehlbarer, langer Zufallsstring. Schuetzt die REST-API (die
# sync-whatsapp Edge Function ruft sie ueber das offene Internet auf, wenn
# der Service auf einem VPS laeuft) - ohne diesen Header antwortet jede
# Route mit 401.
WHATSAPP_SERVICE_API_KEY=change-me-to-a-long-random-string

# Supabase: dieser Service loggt sich als DU SELBST ein (Anon Key + E-Mail/
# Passwort), NIE mit dem Service-Role-Key. Dadurch greift Row Level Security
# ganz normal - selbst wenn dieser Rechner kompromittiert wird, reicht der
# Schaden nur bis an deine eigenen Daten, nicht an die ganze Datenbank.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_USER_EMAIL=deine@email.at
SUPABASE_USER_PASSWORD=

# Label fuer den connected_accounts-Eintrag (provider='whatsapp'), den der
# Service beim ersten Start automatisch anlegt, falls er noch nicht existiert.
WHATSAPP_ACCOUNT_LABEL=WhatsApp

# Nur setzen, wenn Puppeteer eine bereits vorhandene Chromium-Installation
# nutzen soll statt sich selbst eine herunterzuladen (z.B. auf manchen
# VPS-Images mit vorinstalliertem Chromium).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
